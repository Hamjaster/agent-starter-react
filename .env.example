# LiveKit credentials for the video consult. The browser gets a short-lived token from
# app/api/token/route.ts. Without all three, /consult/video sends patients to /consult instead.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Agent dispatch (https://docs.livekit.io/agents/server/agent-dispatch)
# Leave blank: the agent in agent/ registers without a name and uses automatic dispatch.
AGENT_NAME=

# WhatsApp number patients message or call to reach doctor.ai, digits only with country code
# (e.g. 923001234567). With the WAHA bot in whatsapp-bot/, use the number linked to WAHA.
# Leave blank to show setup instructions instead of the WhatsApp hand-off.
SAATHI_WHATSAPP_NUMBER=

# Public URL of the site, used for absolute share-image links (e.g. https://doctor.ai).
# On Vercel this falls back to the deployment URL.
NEXT_PUBLIC_SITE_URL=
